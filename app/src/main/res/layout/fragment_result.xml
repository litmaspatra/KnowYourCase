<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Loading state -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/searching"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:layout_marginTop="16dp" />

    </LinearLayout>

    <!-- Error state -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="48sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/retry"
            android:gravity="center"
            android:textAlignment="center"
            android:layout_marginTop="24dp"
            app:backgroundTint="@color/primary" />

    </LinearLayout>

    <!-- Result content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layoutResult"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header card: title + CNR -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="3dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvCaseTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="17sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif-medium"
                        android:lineSpacingMultiplier="1.3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvCnr"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="#AACCEE"
                            android:fontFamily="monospace" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Next hearing highlight card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNextHearing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NEXT HEARING"
                            style="@style/LabelText" />

                        <TextView
                            android:id="@+id/tvNextHearing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="22sp"
                            android:textColor="@color/primary"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_calendar_outline"
                        android:contentDescription="Next hearing date"
                        android:padding="10dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Details card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CASE DETAILS"
                        style="@style/LabelText"
                        android:layout_marginBottom="16dp" />

                    <!-- Case Stage -->
                    <LinearLayout android:id="@+id/rowStatus"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginBottom="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="CASE STAGE" style="@style/LabelText" android:layout_marginBottom="2dp"/>
                        <TextView android:id="@+id/tvStatus" android:layout_width="match_parent"
                            android:layout_height="wrap_content" style="@style/ValueText"/>
                    </LinearLayout>

                    <!-- Court -->
                    <LinearLayout android:id="@+id/rowCourt"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginBottom="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="COURT" style="@style/LabelText" android:layout_marginBottom="2dp"/>
                        <TextView android:id="@+id/tvCourt" android:layout_width="match_parent"
                            android:layout_height="wrap_content" style="@style/ValueText"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutExpandedDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                    <!-- Case Number -->
                    <LinearLayout android:id="@+id/rowCaseNumber"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginBottom="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="CASE NUMBER" style="@style/LabelText" android:layout_marginBottom="2dp"/>
                        <TextView android:id="@+id/tvCaseNumber" android:layout_width="match_parent"
                            android:layout_height="wrap_content" style="@style/ValueText"/>
                    </LinearLayout>

                    <!-- Case Type -->
                    <LinearLayout android:id="@+id/rowCaseType"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginBottom="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="CASE TYPE" style="@style/LabelText" android:layout_marginBottom="2dp"/>
                        <TextView android:id="@+id/tvCaseType" android:layout_width="match_parent"
                            android:layout_height="wrap_content" style="@style/ValueText"/>
                    </LinearLayout>

                    <!-- Registration Number -->
                    <LinearLayout android:id="@+id/rowRegistrationNumber"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginBottom="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="REGISTRATION NUMBER" style="@style/LabelText" android:layout_marginBottom="2dp"/>
                        <TextView android:id="@+id/tvRegistrationNumber" android:layout_width="match_parent"
                            android:layout_height="wrap_content" style="@style/ValueText"/>
                    </LinearLayout>

                    <!-- Registration Date -->
                    <LinearLayout android:id="@+id/rowRegistrationDate"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginBottom="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="REGISTRATION DATE" style="@style/LabelText" android:layout_marginBottom="2dp"/>
                        <TextView android:id="@+id/tvRegistrationDate" android:layout_width="match_parent"
                            android:layout_height="wrap_content" style="@style/ValueText"/>
                    </LinearLayout>

                    <!-- Filing Date -->
                    <LinearLayout android:id="@+id/rowFilingDate"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginBottom="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="FILING DATE" style="@style/LabelText" android:layout_marginBottom="2dp"/>
                        <TextView android:id="@+id/tvFilingDate" android:layout_width="match_parent"
                            android:layout_height="wrap_content" style="@style/ValueText"/>
                    </LinearLayout>

                    <!-- Judges -->
                    <LinearLayout android:id="@+id/rowJudges"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="JUDGE(S)" style="@style/LabelText" android:layout_marginBottom="2dp"/>
                        <TextView android:id="@+id/tvJudges" android:layout_width="match_parent"
                            android:layout_height="wrap_content" style="@style/ValueText"/>
                    </LinearLayout>

                    <!-- Acts and Sections -->
                    <LinearLayout android:id="@+id/rowActsSections"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginTop="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="ACTS AND SECTIONS" style="@style/LabelText" android:layout_marginBottom="2dp"/>
                        <TextView android:id="@+id/tvActsSections" android:layout_width="match_parent"
                            android:layout_height="wrap_content" style="@style/ValueText"/>
                    </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Parties card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView android:id="@+id/tvPartiesLabel"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PARTIES" style="@style/LabelText" android:layout_marginBottom="16dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginBottom="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="PETITIONER" style="@style/LabelText" android:layout_marginBottom="2dp"/>
                        <TextView android:id="@+id/tvPetitioner" android:layout_width="match_parent"
                            android:layout_height="wrap_content" style="@style/ValueText"/>
                        <TextView android:id="@+id/tvPetitionerAll" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:visibility="gone"
                            style="@style/ValueText"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="PETITIONER ADVOCATE" style="@style/LabelText"
                            android:layout_marginTop="10dp" android:layout_marginBottom="2dp"/>
                        <TextView android:id="@+id/tvPetitionerAdvocate"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            style="@style/ValueText"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/divider" android:layout_marginBottom="14dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="RESPONDENT" style="@style/LabelText" android:layout_marginBottom="2dp"/>
                        <TextView android:id="@+id/tvRespondent" android:layout_width="match_parent"
                            android:layout_height="wrap_content" style="@style/ValueText"/>
                        <TextView android:id="@+id/tvRespondentAll" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:visibility="gone"
                            style="@style/ValueText"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="RESPONDENT ADVOCATE" style="@style/LabelText"
                            android:layout_marginTop="10dp" android:layout_marginBottom="2dp"/>
                        <TextView android:id="@+id/tvRespondentAdvocate"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            style="@style/ValueText"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExpand"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:text="Show all details  ↓"
                android:gravity="center"
                android:textAlignment="center"
                android:textColor="@color/primary"
                android:textSize="14sp"
                app:cornerRadius="12dp" />

            <!-- Partial data notice -->
            <TextView
                android:id="@+id/tvPartialNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/data_partial"
                android:textSize="12sp"
                android:textColor="@color/text_hint"
                android:gravity="center"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <!-- Share button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShare"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:text="Share Case Details"
                android:gravity="center"
                android:textAlignment="center"
                app:icon="@drawable/ic_pixel_share"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="24dp"
                app:iconTint="@color/primary"
                app:backgroundTint="@color/surface"
                android:textColor="@color/primary"
                app:strokeColor="@color/primary"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefresh"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="24dp"
                android:text="Refresh Case Details"
                android:gravity="center"
                android:textAlignment="center"
                android:textColor="@color/primary"
                android:contentDescription="Refresh case details"
                app:icon="@drawable/ic_pixel_reload"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="24dp"
                app:iconTint="@color/primary"
                app:backgroundTint="@color/surface"
                app:strokeColor="@color/primary"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabTranslate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="Translate case details to Hindi"
        android:text="हिंदी"
        android:gravity="center"
        android:textAlignment="center"
        android:textColor="@android:color/white"
        android:visibility="gone"
        app:icon="@drawable/ic_pixel_languages"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconSize="24dp"
        app:iconTint="@android:color/white"
        app:backgroundTint="@color/primary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
