<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.knowyourcase.app.ui.home.HomeFragment"
        android:label="KnowYourCase"
        tools:layout="@layout/fragment_home">
        <action android:id="@+id/action_home_to_scanner"
            app:destination="@id/scannerFragment" />
        <action android:id="@+id/action_home_to_manual"
            app:destination="@id/manualEntryFragment" />
        <action android:id="@+id/action_home_to_history"
            app:destination="@id/historyFragment" />
    </fragment>

    <fragment
        android:id="@+id/scannerFragment"
        android:name="com.knowyourcase.app.ui.scan.ScannerFragment"
        android:label="Scan"
        tools:layout="@layout/fragment_scanner">
        <action android:id="@+id/action_scanner_to_result"
            app:destination="@id/resultFragment" />
        <action android:id="@+id/action_scanner_to_manual"
            app:destination="@id/manualEntryFragment" />
    </fragment>

    <fragment
        android:id="@+id/manualEntryFragment"
        android:name="com.knowyourcase.app.ui.scan.ManualEntryFragment"
        android:label="Enter CNR"
        tools:layout="@layout/fragment_manual_entry">
        <action android:id="@+id/action_manual_to_result"
            app:destination="@id/resultFragment" />
    </fragment>

    <fragment
        android:id="@+id/resultFragment"
        android:name="com.knowyourcase.app.ui.result.ResultFragment"
        android:label="Case Details"
        tools:layout="@layout/fragment_result">
        <argument
            android:name="cnr"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.knowyourcase.app.ui.history.HistoryFragment"
        android:label="Search History"
        tools:layout="@layout/fragment_history">
        <action android:id="@+id/action_history_to_result"
            app:destination="@id/resultFragment" />
    </fragment>

</navigation>
